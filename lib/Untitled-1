  Widget _dayCard(AttendanceDaySummary day, AttendanceState state) {
    final date = day.workDate;
    final dateKey = date == null ? '' : _dateKey(date);
    final selected = state.selectedDate == dateKey && dateKey.isNotEmpty;
    final isWeekend = date != null &&
        (date.weekday == DateTime.saturday || date.weekday == DateTime.sunday);
    final isWeekStart = date != null && date.weekday == DateTime.monday;
    final showRegularization = _shouldShowRegularization(day);
    final showLopActions = _hasLop(day);

    final Color bg;
    final Color bd;
    if (selected) {
      bg = EarthyTheme.sageBackground;
      bd = EarthyTheme.sage;
    } else if (isWeekend) {
      bg = EarthyTheme.weekendBg;
      bd = EarthyTheme.weekendBorder;
    } else if (isWeekStart) {
      bg = EarthyTheme.weekStartBg;
      bd = EarthyTheme.weekStartBorder;
    } else {
      bg = Colors.white;
      bd = EarthyTheme.borderSand;
    }

    // Punch log only exists for the day that was last loaded.
    final dayData = state.dayData;
    final logs = (dayData != null && dayData.date == dateKey)
        ? dayData.punches
            .map((p) => '${_formatTime(p.punchedAt)} (${p.direction})')
            .toList()
        : const <String>[];
    final expanded = _expandedLog == dateKey;
    final shownLogs = expanded ? logs : logs.take(2).toList();

    final flags = <String>[
      if (day.isLate) 'Late',
      if (day.needsRegularization) 'Needs review',
    ];

    return Container(
      decoration: BoxDecoration(
        color: bg,
        borderRadius: BorderRadius.circular(18),
        border: Border.all(color: bd, width: 2),
      ),
      child: Material(
        color: Colors.transparent,
        borderRadius: BorderRadius.circular(18),
        child: InkWell(
          borderRadius: BorderRadius.circular(18),
          onTap: date == null ? null : () => _loadDay(date),
          child: Padding(
            padding: const EdgeInsets.all(16),
            child: Column(
              crossAxisAlignment: CrossAxisAlignment.start,
              children: [
                Row(
                  crossAxisAlignment: CrossAxisAlignment.start,
                  children: [
                    Expanded(child: _dateBadge(date)),
                    _statusPill(day.status),
                  ],
                ),
                const SizedBox(height: 14),
                Container(
                  width: double.infinity,
                  padding: const EdgeInsets.symmetric(horizontal: 14, vertical: 12),
                  decoration: BoxDecoration(
                    color: EarthyTheme.headerBeige,
                    borderRadius: BorderRadius.circular(12),
                    border: Border.all(color: EarthyTheme.border2),
                  ),
                  child: Column(
                    crossAxisAlignment: CrossAxisAlignment.start,
                    children: [
                      _punchTime(true, _formatTime(day.firstIn)),
                      const SizedBox(height: 10),
                      _punchTime(false, _formatTime(day.lastOut)),
                      if (showRegularization) ...[
                        const SizedBox(height: 10),
                        _actionBtn(
                          'Apply regularization',
                          () => _openRequest(
                            AttendanceRequestType.regularization,
                            date,
                          ),
                        ),
                      ],
                    ],
                  ),
                ),
                const SizedBox(height: 12),
                Container(
                  padding: const EdgeInsets.fromLTRB(14, 6, 6, 6),
                  decoration: BoxDecoration(
                    color: Colors.white,
                    borderRadius: BorderRadius.circular(12),
                    border: Border.all(color: EarthyTheme.border2),
                  ),
                  child: Row(
                    children: [
                      Expanded(
                        child: Column(
                          crossAxisAlignment: CrossAxisAlignment.start,
                          children: [
                            const Text(
                              'Total work duration',
                              style: TextStyle(
                                color: EarthyTheme.text600,
                                fontSize: 12,
                                fontWeight: FontWeight.w700,
                              ),
                            ),
                            Text(
                              _formatDuration(day.workMinutes),
                              style: const TextStyle(
                                color: EarthyTheme.text900,
                                fontSize: 16,
                                fontWeight: FontWeight.w900,
                              ),
                            ),
                          ],
                        ),
                      ),
                      IconButton(
                        tooltip: 'View duration breakdown',
                        onPressed: date == null ? null : () => _loadDay(date),
                        icon: const Icon(Icons.visibility_outlined,
                            color: EarthyTheme.forestOlive),
                      ),
                    ],
                  ),
                ),
                if (logs.isNotEmpty) ...[
                  const SizedBox(height: 12),
                  const _Eyebrow('PUNCH LOG'),
                  const SizedBox(height: 4),
                  ...shownLogs.map(
                    (l) => Padding(
                      padding: const EdgeInsets.only(bottom: 3),
                      child: Text(
                        l,
                        style: const TextStyle(
                          color: EarthyTheme.text700,
                          fontSize: 14,
                        ),
                      ),
                    ),
                  ),
                  if (logs.length > 2)
                    GestureDetector(
                      onTap: () =>
                          setState(() => _expandedLog = expanded ? null : dateKey),
                      child: Text(
                        expanded ? 'Show less' : 'Show ${logs.length - 2} more',
                        style: const TextStyle(
                          color: EarthyTheme.forestOlive,
                          fontWeight: FontWeight.w700,
                        ),
                      ),
                    ),
                ],
                const SizedBox(height: 12),
                const Divider(height: 1, color: EarthyTheme.borderSand),
                const SizedBox(height: 10),
                Row(
                  children: [
                    Text.rich(
                      TextSpan(
                        children: [
                          const TextSpan(
                            text: 'LOP ',
                            style: TextStyle(
                              color: EarthyTheme.textMuted,
                              fontSize: 12,
                              fontWeight: FontWeight.w500,
                            ),
                          ),
                          TextSpan(
                            text: showLopActions ? day.lopValue : '-',
                            style: TextStyle(
