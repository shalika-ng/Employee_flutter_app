  Widget _statusPill(String status) {
    final upper = status.toUpperCase();
    final (Color fg, Color bg, Color border) = switch (upper) {
      'PRESENT' || 'IN' => (
          EarthyTheme.forestOlive,
          EarthyTheme.sageBackground,
          EarthyTheme.sageBorder,
        ),
      'LEAVE' || 'INSUFFICIENT' || 'ABSENT' || 'OUT' => (
          EarthyTheme.terracotta,
          EarthyTheme.terracottaBackground,
          EarthyTheme.terracottaBorder,
        ),
      'WEEKLY_OFF' || 'HOLIDAY' => (
          EarthyTheme.sage,
          EarthyTheme.headerBeige,
          EarthyTheme.borderSand,
        ),
      'HALF_DAY' => (
          EarthyTheme.amber,
          EarthyTheme.warmSandLight,
          EarthyTheme.amberBorder,
        ),
      _ => (
          EarthyTheme.textMuted,
          EarthyTheme.headerBeige,
          EarthyTheme.borderSand,
