/// Organic curves behind the main canvas
class _AbstractOrganicPainter extends CustomPainter {
  @override
  void paint(Canvas canvas, Size size) {
    final w = size.width;
    final h = size.height;
    Paint fill(Color c) => Paint()
      ..color = c
      ..style = PaintingStyle.fill;

    // olive – top left
    canvas.drawPath(
      Path()
        ..moveTo(-20, -20)
        ..cubicTo(w * .35, -30, w * .55, h * .06, w * .45, h * .16)
        ..cubicTo(w * .30, h * .26, w * .05, h * .24, -20, h * .30)
        ..close(),
      fill(EarthyTheme.sageLight),
    );
    // sand – top right
    canvas.drawPath(
      Path()
        ..moveTo(w * .65, -20)
        ..cubicTo(w * .75, h * .05, w * .9, h * .10, w + 20, h * .08)
        ..lineTo(w + 20, -20)
        ..close(),
      fill(EarthyTheme.warmSand),
    );
    // sand – right middle
    canvas.drawPath(
      Path()
        ..moveTo(w + 20, h * .35)
        ..cubicTo(w * .85, h * .38, w * .82, h * .46, w * .92, h * .55)
        ..cubicTo(w * .97, h * .60, w + 20, h * .62, w + 20, h * .62)
        ..close(),
      fill(const Color(0xFFD9B288)),
    );
    // terracotta – bottom right
    canvas.drawPath(
      Path()
        ..moveTo(w * .55, h + 20)
        ..cubicTo(w * .70, h * .88, w * .85, h * .80, w + 20, h * .78)
        ..lineTo(w + 20, h + 20)
        ..close(),
      fill(EarthyTheme.terracotta),
    );
    // fine line
    canvas.drawPath(
      Path()
        ..moveTo(-20, h * .45)
        ..cubicTo(w * .3, h * .38, w * .6, h * .55, w + 20, h * .30),
      Paint()
        ..style = PaintingStyle.stroke
        ..strokeWidth = 1.5
        ..color = EarthyTheme.sage.withValues(alpha: 0.35),
    );
  }

  @override
  bool shouldRepaint(covariant CustomPainter oldDelegate) => false;
}

