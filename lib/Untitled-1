class AttendanceScreen extends StatefulWidget {
  const AttendanceScreen({this.onNavigate, super.key});

  final ValueChanged<int>? onNavigate;

  @override
  State<AttendanceScreen> createState() => _AttendanceScreenState();
}

class _AttendanceScreenState extends State<AttendanceScreen> {
  static const _filterPills = [
    'All Status',
    'Present',
    'Late',
    'Half Day',
    'Needs Action',
  ];

  late DateTime _month;
  bool _requestedInitialData = false;
  String _filter = 'All Status';
  String? _expandedLog;

  @override
  void initState() {
    super.initState();
    final now = DateTime.now();
    _month = DateTime(now.year, now.month);
  }

  @override
  void didChangeDependencies() {
    super.didChangeDependencies();
    if (_requestedInitialData) return;
    _requestedInitialData = true;
    WidgetsBinding.instance.addPostFrameCallback((_) {
      if (!mounted) return;
      _loadMonth();
    });
  }

  void _loadMonth() {
    StoreProvider.of<AppState>(context).dispatch(
      FetchAttendanceMonthAction(month: _month.month, year: _month.year),
    );
  }

  void _loadDay(DateTime date) {
    StoreProvider.of<AppState>(context)
        .dispatch(FetchAttendanceDayAction(date: _dateKey(date)));
  }

  void _changeMonth(int offset) {
    setState(() {
      _month = DateTime(_month.year, _month.month + offset);
    });
    _loadMonth();
  }

  Future<void> _pickDate(DateTime initial) async {
    final picked = await showDatePicker(
      context: context,
      initialDate: initial,
      firstDate: DateTime(2020),
      lastDate: DateTime(2100),
      builder: (ctx, child) => Theme(
        data: Theme.of(ctx).copyWith(
          colorScheme: const ColorScheme.light(
            primary: EarthyTheme.forestOlive,
            onPrimary: Colors.white,
            surface: EarthyTheme.creamCanvas,
          ),
        ),
        child: child!,
      ),
    );
    if (picked != null) _goToDate(picked);
  }

  void _goToDate(DateTime date) {
    if (date.month != _month.month || date.year != _month.year) {
      setState(() => _month = DateTime(date.year, date.month));
      _loadMonth();
    }
    _loadDay(date);
  }

  void _openRequest(AttendanceRequestType type, DateTime? date) {
    if (date == null) return;
    Navigator.of(context).push<void>(
      MaterialPageRoute(
        builder: (_) => AttendanceRequestFormScreen(
          type: type,
          initialDate: date,
          onNavigate: widget.onNavigate,
        ),
      ),
    );
  }

  bool _matches(AttendanceDaySummary d) {
    switch (_filter) {
      case 'Present':
        return d.status.toUpperCase() == 'PRESENT';
      case 'Late':
        return d.isLate;
      case 'Half Day':
        return d.status.toUpperCase() == 'HALF_DAY';
      case 'Needs Action':
        return d.needsRegularization;
      default:
        return true;
    }
  }

  /* ------------------------------ BUILD ------------------------------ */

  @override
  Widget build(BuildContext context) {
    return StoreConnector<AppState, AttendanceState>(
      converter: (store) => store.state.attendance,
      onWillChange: (previous, current) {
        if (previous?.dayStatus == AttendanceLoadStatus.loading &&
            current.dayStatus == AttendanceLoadStatus.success &&
            current.dayData != null) {
          WidgetsBinding.instance.addPostFrameCallback((_) {
            if (mounted) _showDayPopup(current.dayData!);
          });
        } else if (previous?.dayStatus == AttendanceLoadStatus.loading &&
            current.dayStatus == AttendanceLoadStatus.failure) {
          WidgetsBinding.instance.addPostFrameCallback((_) {
            if (!mounted) return;
            ScaffoldMessenger.of(context).showSnackBar(
              SnackBar(
                content: Text(
                  current.dayError ?? 'Unable to load day details.',
                  style: const TextStyle(fontWeight: FontWeight.w600),
                ),
                backgroundColor: EarthyTheme.terracotta,
                behavior: SnackBarBehavior.floating,
                shape: RoundedRectangleBorder(
                  borderRadius: BorderRadius.circular(14),
                ),
              ),
            );
          });
        }
      },
      builder: (context, state) {
        return Scaffold(
          backgroundColor: EarthyTheme.backgroundSand,
          body: Stack(
            children: [
              Positioned.fill(
                child: CustomPaint(painter: _AbstractOrganicPainter()),
              ),
              SafeArea(
                child: RefreshIndicator(
                  color: EarthyTheme.forestOlive,
                  backgroundColor: EarthyTheme.creamCanvas,
                  onRefresh: () async {
                    _loadMonth();
                    await Future<void>.delayed(const Duration(milliseconds: 350));
                  },
                  child: ListView(
                    physics: const AlwaysScrollableScrollPhysics(),
                    padding: const EdgeInsets.fromLTRB(12, 12, 12, 24),
                    children: [
                      Container(
                        padding: const EdgeInsets.all(16),
                        decoration: BoxDecoration(
                          color: EarthyTheme.creamCanvas,
                          borderRadius: BorderRadius.circular(32),
                          border: Border.all(
                            color: EarthyTheme.borderSand.withValues(alpha: 0.8),
                          ),
                          boxShadow: [
                            BoxShadow(
                              color: const Color(0xFF483C2D).withValues(alpha: 0.08),
                              blurRadius: 40,
                              offset: const Offset(0, 16),
                            ),
                          ],
                        ),
                        child: Column(
                          crossAxisAlignment: CrossAxisAlignment.start,
                          children: [
                            _buildHeader(state),
                            const SizedBox(height: 16),
                            _buildFilterCard(state),
                            if (state.monthData != null) ...[
                              const SizedBox(height: 16),
                              _buildTodayCard(state.monthData!.today),
                              const SizedBox(height: 16),
                              _buildSummary(
                                state.monthData!.totals,
                                state.monthData!.days.length,
                              ),
                            ],
                            const SizedBox(height: 16),
                            _buildHistoryCard(state),
                          ],
                        ),
                      ),
                    ],
                  ),
                ),
              ),
            ],
          ),
        );
      },
    );
  }

